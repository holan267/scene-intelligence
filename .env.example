# Scene Intelligence — cấu hình mẫu (copy sang .env). KHÔNG commit .env thật.

# PostgreSQL (nguồn sự thật — AD-4). Dùng driver async psycopg.
DATABASE_URL=postgresql+psycopg://scene:scene@localhost:5432/scene_intelligence

# Media storage nội bộ (AD-23). Backend filesystem cho MVP.
MEDIA_BACKEND=filesystem
# Đường mount kho media (NAS/SAN cho kho thật, ổ local cho dev).
MEDIA_ROOT=./_data/media

# Môi trường chạy
API_ENV=dev

# Worker — stage chạy khi nạp video.
# Detect (tách scene/shot) dùng PySceneDetect, đã có sẵn trong dependencies.
DETECT_ON_INGEST=true
# ASR (PhoWhisper-large) + OCR (VietOCR) chạy in-process trong worker. Mặc định TẮT vì
# faster-whisper/easyocr/vietocr và trọng số model KHÔNG nằm trong dependencies — bật khi
# node worker đã cài đủ, nếu không mọi task nạp sẽ rơi vào 'error'.
ENRICH_ON_INGEST=false
# false => chỉ ASR, bỏ OCR (không đụng scene.ocr_text).
ENRICH_OCR=false
# Trọng số nạp từ ĐĨA, không bao giờ tải lúc chạy (air-gap AD-14). Dựng bằng:
#   uv pip install -e '.[enrich,fetch-models]' && deploy/fetch-models.sh
ASR_MODEL_DIR=./_data/models/PhoWhisper-large-ct2
OCR_DETECTOR_DIR=./_data/models/easyocr
OCR_RECOGNIZER_DIR=./_data/models/vietocr
# cpu | cuda — cho EasyOCR/VietOCR (faster-whisper tự dò).
ENRICH_DEVICE=cpu
# describe (Qwen3-VL) + embed/index (BGE-M3) — stage DUY NHẤT đưa scene sang
# search_status='indexed' (AD-17); tắt thì scene ở 'pending' và search trả rỗng.
# Cần hai model server bên dưới đang chạy, nếu không mọi task nạp sẽ rơi vào 'error'.
INDEX_ON_INGEST=false
# Endpoint OpenAI-compatible (AD-14). Dev trên 1 máy: Ollama (`ollama serve`, cổng 11434)
# phục vụ CẢ Qwen3-VL (describe) lẫn BGE-M3 (embed) => hai URL trùng nhau.
#   ollama pull qwen3-vl:2b && ollama pull bge-m3
DESCRIBE_MODEL_URL=http://localhost:11434
EMBED_MODEL_URL=http://localhost:11434
# Tag describe phải là tag DẪN XUẤT có num_ctx nới rộng, không phải `qwen3-vl:2b` trần:
# num_ctx=4096 mặc định của Ollama không đủ cho prompt có keyframe + phần "suy nghĩ" của
# model, request trả về content rỗng và scene không bao giờ được index. Dựng tag một lần:
#   curl http://localhost:11434/api/create \
#     -d '{"model":"qwen3-vl:2b-ctx16k","from":"qwen3-vl:2b","parameters":{"num_ctx":16384}}'
# deploy/run-worker.sh tự dựng nếu chưa có. Chi tiết: deploy/README.md.
DESCRIBE_MODEL_NAME=qwen3-vl:2b-ctx16k
