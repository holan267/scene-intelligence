# Cấu hình worker host riêng theo máy — copy sang deploy/worker.local.env (KHÔNG commit).
# deploy/run-worker.sh tự nạp file này; biến đã export ở shell luôn thắng.
# Chỉ cần ghi những dòng KHÁC mặc định trong run-worker.sh.

# Kho media — thường khác _data/media khi dùng ổ ngoài/NAS.
MEDIA_ROOT=/Users/lanho/media

# Postgres của compose (cổng 5432 đã publish ra host).
# DATABASE_URL=postgresql+psycopg://scene:scene@localhost:5432/scene_intelligence

# Bật OCR sau khi đã nạp trọng số vào _data/models/vietocr + easyocr.
# ENRICH_OCR=true

# Ollama phục vụ CẢ describe (qwen3-vl) lẫn embed (bge-m3) trên cùng cổng.
# DESCRIBE_MODEL_URL=http://localhost:11434
# EMBED_MODEL_URL=http://localhost:11434

# Đổi model describe: run-worker.sh tự dựng tag dẫn xuất (num_ctx nới rộng) từ tag gốc.
# Mô tả cụt/rỗng vì model suy nghĩ quá dài => tăng DESCRIBE_NUM_CTX rồi đổi luôn tên tag
# (tag cũ đã tồn tại sẽ không được dựng lại).
# DESCRIBE_BASE_MODEL=qwen3-vl:4b
# DESCRIBE_MODEL_NAME=qwen3-vl:4b-ctx16k
# DESCRIBE_NUM_CTX=16384

# Describe bằng API DeepSeek thay cho Ollama tự host (máy yếu, không chạy nổi model VL).
# Đánh đổi: keyframe rời khỏi máy chủ — chỉ dùng cho tư liệu được phép ra ngoài.
# DESCRIBE_BACKEND=deepseek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_MODEL=deepseek-flash
