# Cấu hình riêng theo máy cho docker compose (copy sang deploy/.env — KHÔNG commit .env).
# Docker Compose tự đọc file .env nằm cùng thư mục với docker-compose.yml.

# Đường host tới kho media, bind-mount vào /data/media trong container.
#   Windows:     MEDIA_HOST_PATH=D:/media
#   macOS:       MEDIA_HOST_PATH=/Users/<user>/media   (hoặc /Volumes/<ổ ngoài>/media)
#   Linux/NAS:   MEDIA_HOST_PATH=/mnt/nas/media
# Bỏ trống/không đặt => mặc định ../_data/media (thư mục _data ở gốc repo, dùng cho dev).
MEDIA_HOST_PATH=../_data/media

# Model server BGE-M3 (nhúng scene_document khi ingest + nhúng câu truy vấn khi search).
# Chạy bằng Ollama trên HOST, không trong compose (cần Metal/GPU của máy):
#   ollama pull bge-m3 && ollama serve      # mở cổng 11434
# Bỏ trống => mặc định http://host.docker.internal:11434 (host nhìn từ trong container).
# Đổi sang vLLM/TEI khi triển khai on-prem có GPU, vd http://10.0.0.5:8002
EMBED_MODEL_URL=http://host.docker.internal:11434

# Bước detect (tách scene/shot + keyframe) chạy ngay trong worker khi nạp lô.
# false => chỉ đăng ký Video vào danh mục, không decode (nạp nhanh, detect sau).
DETECT_ON_INGEST=true
# Ngưỡng ContentDetector: thấp hơn => cắt nhiều cảnh hơn. 27.0 = mặc định thư viện.
DETECT_THRESHOLD=27.0
